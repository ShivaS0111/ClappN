# Copy to .env (never commit real secrets) and export before starting, e.g.:
#   set -a; source .env; set +a   (bash)
#   Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }
#
# Or set the same names in your host / Docker / K8s secrets.

SPRING_PROFILES_ACTIVE=prod

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/clapp?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=clapp
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# --- JWT (required in prod; long random string) ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=3600000

# --- CORS (comma-separated frontend origins) ---
APP_CORS_ORIGINS=https://app.yourdomain.com

# --- Payments: enable only what you use ---
# APP_PAYMENT_PROVIDERS=stripe
# APP_PAYMENT_PROVIDERS=razorpay
APP_PAYMENT_PROVIDERS=stripe,razorpay

# Stripe (Dashboard → Developers → API keys + Webhooks)
STRIPE_SECRET=sk_live_or_sk_test_...
STRIPE_PUBLISHABLE=pk_live_or_pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_STRIPE_SUCCESS_URL=https://app.yourdomain.com/payment/callback
PAYMENT_STRIPE_CANCEL_URL=https://app.yourdomain.com/payment/callback

# Razorpay (Dashboard → API Keys + Webhooks)
RAZORPAY_KEY_ID=rzp_live_or_rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Webhook URLs to register at the provider:
#   POST https://api.yourdomain.com/api/payments/webhook/stripe
#   POST https://api.yourdomain.com/api/payments/webhook/razorpay

# --- Mail (prod should use smtp) ---
APP_MAIL_MODE=smtp
APP_MAIL_FROM=noreply@yourdomain.com
APP_RESET_PASSWORD_URL=https://app.yourdomain.com/reset-password
SPRING_MAIL_HOST=smtp.yourprovider.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Auth rate limit ---
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_AUTH_MAX_REQUESTS=30
APP_RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# --- Staging smoke (against a running API) ---
# STAGING_BASE_URL=http://localhost:9090
# STAGING_EMAIL=
# STAGING_PASSWORD=
# STAGING_STORE_ID=
# STAGING_BUSINESS_ID=
# STAGING_PAYMENT_GATEWAY=RAZORPAY
# STAGING_SKIP_ORDER=false

# --- Optional ---
MANAGEMENT_PORT=9091
APP_SLOW_REQUEST_MS=1500
